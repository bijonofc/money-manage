# ==============================================================================
# Money Manage - Production Environment Variables for Render.com
# ==============================================================================
# Copy and paste these into your Render Dashboard -> Environment Variables
# or use this file as a reference for your production deployment.
# ==============================================================================

# Application Configuration
APP_NAME="MoneyManage"
APP_ENV=production
APP_KEY=base64:q9pzwK1DO9eQ6ZwIsPl1z+kW9MmlkJIT/5PtOCtYRFQ=
APP_DEBUG=false
APP_URL=https://your-service-name.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logging (stderr sends logs directly to Render's live console)
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database (PostgreSQL / Supabase)
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME="postgres.dentcmfulmljavqutcaw"
DB_PASSWORD=P6zsnSaKlDiydc1X
DB_SSLMODE=require

# Session Configuration (HTTPS / Production ready)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Cache, Queue, and Filesystem
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Deployment Automation (Triggers 'php artisan migrate --force' on container startup)
RUN_MIGRATIONS=true
AUTO_MIGRATE=true

# Mail Configuration (Set to log driver by default; update with SMTP when ready)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend Vite
VITE_APP_NAME="${APP_NAME}"
